# Copy to .env.local (for `vercel dev`) and set the same vars in Vercel.
# Browser-exposed (Vite only exposes VITE_-prefixed vars). Safe to be public.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. NEVER commit real values; never expose to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CLICKUP_TOKEN=pk_your_activatus_workspace_token

# Shared password that unlocks the /?admin=1 invite manager (server-side only).
ADMIN_TOKEN=choose-a-long-random-admin-password
